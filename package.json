{
  "name": "osint-fusion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test src/lib/__tests__/logger.test.ts src/lib/__tests__/recovery.test.ts src/lib/__tests__/audit-chain.test.ts",
    "test:db": "tsx --test src/lib/__tests__/db-adapter.test.ts src/lib/__tests__/refresh-rotation.test.ts src/lib/__tests__/worm-export.test.ts",
    "test:e2e": "tsx --test src/lib/__tests__/orchestrator-e2e.test.ts src/lib/__tests__/smoke.test.ts",
    "stress": "tsx --test src/lib/__tests__/stress.test.ts",
    "test": "npm run test:unit && npm run test:db && npm run test:e2e",
    "verify": "npm run typecheck && npm run test && npm run stress && npm run build",
    "db:verify": "npm run test:db",
    "prebuild": "node scripts/write-build-id.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@libsql/client": "^0.14.0",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^11.5.0",
    "lucide-react": "^0.468.0",
    "next": "15.1.0",
    "pg": "^8.13.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

# ─── Runtime ────────────────────────────────────────────────
NODE_ENV=development

# ─── Banco de dados ─────────────────────────────────────────
# Um dos três formatos:
#   sqlite:./.data/osint-fusion.db
#   postgres://user:pass@host:5432/db
#   libsql://xxx.turso.io
DATABASE_URL=sqlite:./.data/osint-fusion.db
DATABASE_AUTH_TOKEN=
PG_POOL_MAX=10

# ─── Rate limiting (Upstash Redis REST) ─────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Cloudflare Turnstile ───────────────────────────────────
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ─── WORM (S3 Object Lock, modo COMPLIANCE) ─────────────────
WORM_S3_BUCKET=
WORM_S3_REGION=
WORM_S3_ENDPOINT=
WORM_S3_ACCESS_KEY_ID=
WORM_S3_SECRET_ACCESS_KEY=
WORM_RETAIN_DAYS=2555

# ─── Cron / Admin ───────────────────────────────────────────
CRON_SECRET=
ADMIN_EXPORT_TOKEN=

# ─── Orquestrador ───────────────────────────────────────────
NEXT_PUBLIC_VOIDACCESS_URL=https://void.internal
NEXT_PUBLIC_AIMAP_URL=https://aimap.internal
